# The component-test conformance harness: builders produce artifacts,
# runners execute prebuilt artifacts, the aggregate joins result
# streams against the committed lockfile and targets.toml and diffs
# the committed matrix.

import '../../justfile.shared.just'

# Hard cap on any single leg, so a wedged run cannot hang a CI job to
# its timeout. Empty where GNU coreutils' `timeout` is missing (macOS):
# the caps only bound CI-shaped environments.
timeout_cmd := `command -v timeout >/dev/null 2>&1 && echo "timeout 600" || echo ""`

ct_cli := root / "target/ct-tools/bin/component-test"
suite_wasm := root / "target/wasm32-wasip2/release/conformance_guest_ct.wasm"
results := root / "conformance/driver-ct/results"

default: all

# Build + lockfile gate + run every leg + aggregate + matrix gate.
all: build lock-check run-wasmtime run-composed run-deltic run-deltic-browser aggregate matrix-check

# ----- builders ---------------------------------------------------------------

build-suite:
    cargo build --manifest-path {{root}}/Cargo.toml \
        --target wasm32-wasip2 --release -p conformance-guest-ct

build-driver:
    cargo build --manifest-path {{root}}/Cargo.toml -p conformance-ct-driver

# The component-test CLI, installed --locked from the same git rev
# Cargo.lock pins for the library crates (the lock is the single source
# of truth; same-rev reruns are a no-op "already installed"). The
# bootstrap extraction anchors on the crate name, not the repository
# URL (URLs change on renames): the sdk's [[package]] block in
# Cargo.lock carries the git source to install from. The pins gate then
# asserts one rev everywhere — a skewed bump runs the JS harness
# against a Rust runner from a different rev. The deltic browser driver's
# lockfile is the only JS pin site left: the WPT parity tree stopped
# consuming the runner core when its jco carrier retired.
_ct-tools:
    #!/usr/bin/env bash
    set -euo pipefail
    cd '{{root}}'
    src=$(grep -m1 -A2 '^name = "component-test-sdk"' Cargo.lock | grep '^source = "git+')
    url=$(printf '%s' "$src" | sed -E 's/^source = "git\+([^?]+)\?.*/\1/')
    rev=$(printf '%s' "$src" | grep -oE '[0-9a-f]{40}' | head -n1)
    if [ ! -x target/ct-tools/bin/component-test ] || [ "$(cat target/ct-tools/.rev 2>/dev/null)" != "$rev" ]; then
        cargo install --locked --root target/ct-tools --git "$url" --rev "$rev" component-test-cli
        printf '%s' "$rev" > target/ct-tools/.rev
    fi
    target/ct-tools/bin/component-test pins --cargo-lock Cargo.lock \
        --js-lock conformance/driver-ct/deltic/pnpm-lock.yaml \
        --expect "$rev" > /dev/null

build-echod:
    cargo build --manifest-path {{root}}/Cargo.toml -p conformance-echod

# The in-guest provider (wasm32-wasip2 emits a component directly).
build-provider:
    cargo build --manifest-path {{root}}/Cargo.toml --release -p websocket-guest-provider --target wasm32-wasip2

# The polymorph:tls component, cloned lazily at the rev pinned by
# rust/guest-provider/tls-component.rev and built from source (the
# project publishes no artifacts yet). The checkout lives under target/
# (build territory).
build-tls-component:
    #!/usr/bin/env bash
    set -euo pipefail
    rev="$(cat {{root}}/rust/guest-provider/tls-component.rev)"
    dir={{root}}/target/deps/component-tls
    clone() {
        rm -rf "$dir"
        mkdir -p "$(dirname "$dir")"
        git clone https://github.com/polymorph-components/polymorph-tls "$dir"
    }
    [ -d "$dir/.git" ] || clone
    if [ "$(git -C "$dir" rev-parse HEAD 2>/dev/null)" != "$rev" ]; then
        # A clone carries every commit reachable from a branch, so the pin
        # normally needs no fetch, and GitHub's upload-pack serves
        # fetch-by-sha only best-effort for non-tip commits. A checkout that
        # cannot produce the pin even so (e.g. an object store mangled by
        # target/ caching) is disposable build territory: re-clone.
        git -C "$dir" cat-file -e "$rev^{commit}" 2>/dev/null || \
            git -C "$dir" fetch origin "$rev" || true
        git -C "$dir" checkout --detach "$rev" || { clone; git -C "$dir" checkout --detach "$rev"; }
    fi
    cd "$dir"
    cargo build --release --target wasm32-wasip2 -p polymorph-tls-component

# The composed leg's component: the suite with its polymorph:websocket import
# plugged by the provider (which carries the TLS component for wss:).
# The composed artifact keeps the suite's file stem (the results
# envelope names the suite after it; the lockfile must agree) in its own
# directory.
compose-suite: build-suite build-provider build-tls-component
    mkdir -p {{root}}/target/wasm32-wasip2/release/composed
    wac plug --plug {{root}}/target/deps/component-tls/target/wasm32-wasip2/release/polymorph_tls_component.wasm \
        {{root}}/target/wasm32-wasip2/release/websocket_guest_provider.wasm \
        -o {{root}}/target/wasm32-wasip2/release/composed/websocket-guest-provider-tls.wasm
    wac plug --plug {{root}}/target/wasm32-wasip2/release/composed/websocket-guest-provider-tls.wasm \
        {{suite_wasm}} \
        -o {{root}}/target/wasm32-wasip2/release/composed/conformance_guest_ct.wasm

build: build-suite build-driver build-echod _ct-tools

# ----- lockfile ---------------------------------------------------------------

# The committed inventory is the corpus mirror (replacing the incumbent
# four-way mirror): drift fails here and in the runner's cross-check.
lock-check: build-suite _ct-tools
    {{ct_cli}} lock {{suite_wasm}} \
        --check {{root}}/conformance/guest-ct/tests.lock

# Regenerate after suite changes; commit the diff (the review surface).
lock-update: build-suite _ct-tools
    {{ct_cli}} lock {{suite_wasm}} \
        -o {{root}}/conformance/guest-ct/tests.lock

# ----- runners ----------------------------------------------------------------

run-wasmtime: build-suite build-driver
    mkdir -p {{results}}
    {{timeout_cmd}} {{root}}/target/debug/ct-driver {{suite_wasm}} \
        --jsonl --jobs 4 --target wasmtime > {{results}}/wasmtime.jsonl

run-composed: compose-suite build-driver build-echod
    {{timeout_cmd}} {{root}}/target/debug/ct-driver \
        {{root}}/target/wasm32-wasip2/release/composed/conformance_guest_ct.wasm \
        --composed --suite-artifact {{suite_wasm}} \
        --jsonl --jobs 4 --target composed > {{results}}/composed.jsonl

# The deltic-native leg: runtime-linked under stock Deno, no transpile
# step. The translator comes from the packaged `@deltic/translator` JSR
# prerelease through the module graph — no fetch step, no sha256
# bookkeeping, no net grant. run.ts owns the suite run. Scoped
# permissions throughout, EXCEPT --allow-run: Deno refuses a *scoped*
# --allow-run outright whenever dynamic-linker vars (LD_LIBRARY_PATH
# etc.) sit in the ambient environment — they could redirect the allowed
# binary, and no --allow-env grant lifts the refusal (verified on Deno
# 2.9.5). Ambient LD_LIBRARY_PATH is common on dev machines and run.ts is
# in-repo trusted code, so --allow-run stays unscoped; the spawn target
# is still just the echod binary. DENO_CERT provisions trust for the
# suite's committed test PKI, the Deno analogue of the NODE_EXTRA_CA_CERTS
# the retired jco Node leg carried (see git history).
run-deltic: build-suite build-echod
    #!/usr/bin/env bash
    set -euo pipefail
    mkdir -p {{results}}
    DENO_CERT={{root}}/conformance/server/tls/ca.pem {{timeout_cmd}} deno run \
        --config {{root}}/conformance/driver-ct/deltic/deno.json --frozen \
        --allow-read={{root}} \
        --allow-write={{results}} \
        --allow-net=127.0.0.1,localhost \
        --allow-run \
        --allow-env=DENO_CERT \
        {{root}}/conformance/driver-ct/deltic/run.ts \
        --out {{results}}/deltic-deno.jsonl --target deltic-deno

# The deltic browser driver's npm tree (the upstream page driver +
# worker message loop + playwright-core; no transpiler).
_deltic-browser-prepared:
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{root}}/conformance/driver-ct/deltic
    if [ pnpm-lock.yaml -nt node_modules/.modules.yaml ]; then
        pnpm install --silent
    fi

# The suite runtime-linked inside headless Chromium against the deltic
# host module: the worker is one deno-bundled module (engine + host
# module + message loop; browser/worker-entry.ts), so no transpile step
# and no generated tree.
run-deltic-browser: build-suite build-echod _deltic-browser-prepared (extract-deltic-translator root / "target/deltic-browser")
    #!/usr/bin/env bash
    set -euo pipefail
    cd {{root}}/conformance/driver-ct/deltic
    mkdir -p {{root}}/target/deltic-browser
    deno bundle --config deno.json --frozen --platform browser \
        -o {{root}}/target/deltic-browser/websocket-worker.mjs browser/worker-entry.ts
    mkdir -p {{results}}
    {{timeout_cmd}} node run-browser.mjs

# ----- aggregation -------------------------------------------------------------

aggregate: _ct-tools
    {{ct_cli}} aggregate \
        --lock {{root}}/conformance/guest-ct/tests.lock \
        --manifest {{root}}/conformance/driver-ct/targets.toml \
        --results wasmtime={{results}}/wasmtime.jsonl \
        --results composed={{results}}/composed.jsonl \
        --results deltic-deno={{results}}/deltic-deno.jsonl \
        --results deltic-browser={{results}}/deltic-browser.jsonl \
        -o {{results}}/matrix.md

# The committed matrix is the cross-target review surface; regenerate
# with matrix-update and commit the diff.
matrix-check:
    diff -u {{root}}/conformance/driver-ct/matrix.md {{results}}/matrix.md

matrix-update:
    cp {{results}}/matrix.md {{root}}/conformance/driver-ct/matrix.md
